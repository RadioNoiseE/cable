{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "http_clients": [
    {
      "detour": "snell",
      "tag": "http"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "address": [
        "10.0.0.1/24",
        "fd00::1/64"
      ],
      "dns_mode": "native",
      "dns_address": [
        "1.1.1.1",
        "2606:4700:4700::1111"
      ],
      "auto_route": true,
      "auto_redirect": true,
      "strict_route": true
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "snell",
      "tag": "snell",
      // server
      // server_port
      "version": 4,
      // psk
    }
  ],
  "route": {
    "rules": [
      { "action": "sniff" },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "protocol": "bittorrent" },
          { "ip_is_private": true },
          {
            "rule_set": [
              "geoip-cn",
              "geosite-geolocation-cn"
            ]
          }
        ],
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geoip-cn",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-cn",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-cn.srs"
      }
    ],
    "final": "snell",
    "auto_detect_interface": true
  }
}
